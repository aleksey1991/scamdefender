{
  "name": "scamdefender-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend for ScamDefender",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --ci"
  },
  "keywords": ["cloudflare-workers", "scam-detection", "typescript"],
  "author": "ScamDefender Team",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-types": "^4.20241127.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
